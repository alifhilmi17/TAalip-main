{
  "name": "libas-desktop",
  "version": "1.0.0",
  "description": "Lintau Buo Administration System - Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/sync-version.js && electron .",
    "version:sync": "node scripts/sync-version.js",
    "clean": "powershell -NoProfile -Command \"if (Test-Path dist_installer) { Remove-Item -Path dist_installer -Recurse -Force; Write-Host 'Folder dist_installer berhasil dibersihkan!' } else { Write-Host 'Folder dist_installer sudah bersih.' }\"",
    "predist": "node scripts/sync-version.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "keywords": [
    "libas",
    "peternakan",
    "desktop",
    "electron"
  ],
  "author": "Muhammad Alif Hilmi",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.libas.peternakan",
    "productName": "LIBAS",
    "copyright": "Copyright © 2026 Muhammad Alif Hilmi - Final Project - Politeknik Negeri Batam",
    "directories": {
      "output": "LIBAS_installer"
    },
    "files": [
      "**/*",
      "!dist*/*",
      "!build/*",
      "!.git/*",
      "!.vscode/*",
      "!*.rar",
      "!*.log",
      "!*.bat",
      "!installer/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LIBAS - Sistem Administrasi Peternakan",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
